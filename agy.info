in writer.cpp {


when user command : write <title> { 


exec-once : nano <title>.txt

}


when user command : prep <title> {

parse <title>.txt through gemini.cpp 

when user command : make <title> {

parse <title>.txt through renderer.cpp
}




}



}














in ai.cpp {





use gemini-api key - .env file 
model endpoint : gemini-2.5-flash-image

use following api request method


when recived <title>.txt through gemini.cpp {

send requesto to API with the JSON

JSON {
{
  "systemInstruction": {
    "parts": [
      {
        "text": "Make a image for the provided .txt file which contains the contents of a blog. the image should be 
  		image dimensions : 1.5 : 1 , rectangular"
      }
    ]
  },
  "contents": [
    {
      "role": "user",
      "parts": [
        {
          "fileData": {
            "mimeType": "text/plain",
            "fille": "<title>.txt"
          }
        }
      ]
    }
  ]
}
}

save recieved image to path : /assets 






}


}


}












in renderer.cpp {

when activated with input : title by main.cpp {

pick <title.txt> from path : /temp

pick template.html from path /template


create a new html file as : <title>.html

add to path : /blogs



} 



inside template in template.html {


<title> = <topic>


<body> {

<div class="image-container">
  <img src="<title>.jpg" alt="<title>">
  <div class="overlay-text"> <title> </div>
</div>

.image-container {
  position: relative;
  display: inline-block; /* Keeps the container the exact same size as the image */
}


.image-container img {
  display: block;
  width: 100%;
  height: auto;
}


.overlay-text {
  position: absolute;
  top: 50%;                 /* Moves the top edge of the text to the vertical center */
  left: 50%;                /* Moves the left edge of the text to the horizontal center */
  transform: translate(-50%, -50%); /* Shifts the text back by half its own width and height */
  

  color: white;             
  font-size: 24px;
  font-family: sans-serif;
  text-align: center;
}



text {

txt-color = Charcoal (#2C2C2C)

text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.4);



<pre> { content from <title>.txt }

}

bg {

bg-img = bg.jpg 

background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('wood.jpg');


}

}




